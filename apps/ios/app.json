{
  "expo": {
    "name": "Peanut Count",
    "slug": "peanut-count",
    "version": "0.1.0",
    "scheme": "peanutcount",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "org.peanutcount.ios",
      "supportsTablet": true
    },
    "userInterfaceStyle": "automatic",
    "plugins": [
      ["expo-sharing", {
        "ios": {
          "enabled": true,
          "activationRule": "SUBQUERY(extensionItems, $item, SUBQUERY($item.attachments, $attachment, ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO 'com.adobe.pdf').@count == 1).@count == 1"
        }
      }],
      "expo-secure-store",
      ["expo-sqlite", { "useSQLCipher": true }]
    ]
  }
}
